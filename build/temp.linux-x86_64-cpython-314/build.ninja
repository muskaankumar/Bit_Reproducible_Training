ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -pthread -B /ext3/miniconda3/compiler_compat -fno-strict-overflow -Wsign-compare -DNDEBUG -O2 -Wall -fPIC -O2 -isystem /ext3/miniconda3/include -fPIC -O2 -isystem /ext3/miniconda3/include -fPIC -Irepro_gelu -Irepro_dropout -Irepro_layernorm -Irepro_embedding -Irepro_attention -I/ext3/miniconda3/lib/python3.14/site-packages/torch/include -I/ext3/miniconda3/lib/python3.14/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda/include -I/ext3/miniconda3/include/python3.14 -c
post_cflags = -O2 -std=c++20 -fno-fast-math -ffp-contract=off -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_gpt2_backend
cuda_cflags = -Irepro_gelu -Irepro_dropout -Irepro_layernorm -Irepro_embedding -Irepro_attention -I/ext3/miniconda3/lib/python3.14/site-packages/torch/include -I/ext3/miniconda3/lib/python3.14/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda/include -I/ext3/miniconda3/include/python3.14 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -arch=sm_80 --fmad=false -O2 --ftz=false --prec-div=true --prec-sqrt=true -std=c++20 -lineinfo -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_gpt2_backend
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







build /home/mk10608/gpt2_repro_project/build/temp.linux-x86_64-cpython-314/bindings.o: cuda_compile /home/mk10608/gpt2_repro_project/bindings.cu
build /home/mk10608/gpt2_repro_project/build/temp.linux-x86_64-cpython-314/repro_attention/repro_attention.o: cuda_compile /home/mk10608/gpt2_repro_project/repro_attention/repro_attention.cu
build /home/mk10608/gpt2_repro_project/build/temp.linux-x86_64-cpython-314/repro_dropout/repro_dropout.o: cuda_compile /home/mk10608/gpt2_repro_project/repro_dropout/repro_dropout.cu
build /home/mk10608/gpt2_repro_project/build/temp.linux-x86_64-cpython-314/repro_embedding/repro_embedding.o: cuda_compile /home/mk10608/gpt2_repro_project/repro_embedding/repro_embedding.cu
build /home/mk10608/gpt2_repro_project/build/temp.linux-x86_64-cpython-314/repro_gelu/repro_gelu.o: cuda_compile /home/mk10608/gpt2_repro_project/repro_gelu/repro_gelu.cu
build /home/mk10608/gpt2_repro_project/build/temp.linux-x86_64-cpython-314/repro_layernorm/repro_layernorm.o: cuda_compile /home/mk10608/gpt2_repro_project/repro_layernorm/repro_layernorm.cu








